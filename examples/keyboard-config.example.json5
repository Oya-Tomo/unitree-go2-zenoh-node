{
  zenoh_key_prefix: "unitree/go2",
  loop_frequency_hz: 20,
  // Mark the dashboard stale if periodic Node State stops arriving.
  node_state_timeout_seconds: 2.5,

  // Conservative operator targets, not the SDK validation limits.
  velocity_targets: {
    vx: 0.5,
    vy: 0.3,
    vyaw: 1.0,
  },

  // Maximum change per second for the keyboard-generated command.
  velocity_ramp_rates: {
    vx_mps2: 1.0,
    vy_mps2: 0.8,
    vyaw_rad_s2: 2.0,
  },
}
