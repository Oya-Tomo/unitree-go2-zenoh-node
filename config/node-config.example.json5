{
  // Every node controls one robot through one network interface.
  robot_key: "unitree/go2",
  // Republish the current state so clients can detect a dead or disconnected node.
  state_heartbeat_seconds: 1.0,

  dds: {
    domain_id: 0,
    network_interface: "enp2s0",
    // Bounds each SDK request phase; synchronous calls still block the control loop.
    rpc_timeout_seconds: 0.2,
  },

  safety: {
    command_timeout_seconds: 0.25,
    posture_transition_seconds: 3.0,
    shutdown_stop_delay_seconds: 1.0,
  },
}
